
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Logs | AquaPiol</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 text-slate-800">
  <div class="min-h-screen flex flex-col md:flex-row">

    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 bg-slate-900 text-white p-6">
      <h1 class="text-2xl font-bold mb-1">AquaPiol</h1>
      <p class="text-sm text-slate-400 mb-8">Bongabong</p>

      <nav class="space-y-2">
        <a href="/dashboard" class="block px-4 py-3 rounded-lg hover:bg-slate-700">
          Dashboard
        </a>
        <a href="/customers" class="block px-4 py-3 rounded-lg hover:bg-slate-700">
          Customers
        </a>
        <a href="/customer-logs" class="block px-4 py-3 rounded-lg bg-cyan-600 font-semibold">
          Customer Logs
        </a>
        <a href="/logout" class="block px-4 py-3 rounded-lg hover:bg-slate-700">
          Logout
        </a>
      </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 p-5 md:p-8">

      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-8">
        <div>
          <h2 class="text-2xl font-bold">Customer Logs</h2>
          <p class="text-slate-500 mt-1">Manage customer activities, concerns, and feedback.</p>
        </div>
        <span class="text-sm text-slate-500">AquaPiol Customer Management</span>
      </header>

      <!-- STATISTICS -->
      <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-slate-500">Total Logs</p>
          <h3 id="totalLogs" class="text-3xl font-bold mt-2">0</h3>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-slate-500">Open</p>
          <h3 id="openLogs" class="text-3xl font-bold text-amber-600 mt-2">0</h3>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-slate-500">In Progress</p>
          <h3 id="progressLogs" class="text-3xl font-bold text-blue-600 mt-2">0</h3>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-slate-500">Resolved</p>
          <h3 id="resolvedLogs" class="text-3xl font-bold text-green-600 mt-2">0</h3>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-slate-500">Closed</p>
          <h3 id="closedLogs" class="text-3xl font-bold text-slate-600 mt-2">0</h3>
        </div>
      </section>

      <!-- ADD CUSTOMER LOG -->
      <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="mb-5">
          <h3 class="text-lg font-bold">Add Customer Log</h3>
          <p class="text-sm text-slate-500">Record a refill activity, customer concern, or feedback.</p>
        </div>

        <form id="customerLogForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">

          <div>
            <label for="customerId" class="block text-sm font-medium mb-2">
              Select Customer
            </label>
            <select id="customerId" required
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <option value="">Loading customers...</option>
            </select>
          </div>

          <div>
            <label for="logType" class="block text-sm font-medium mb-2">
              Log Type
            </label>
            <select id="logType" required
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <option value="">Select log type</option>
              <option value="refill">Refill</option>
              <option value="concern">Concern</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>

          <div>
            <label for="logStatus" class="block text-sm font-medium mb-2">
              Initial Status
            </label>
            <select id="logStatus"
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <option value="open">Open</option>
              <option value="in_progress">In Progress</option>
              <option value="resolved">Resolved</option>
              <option value="closed">Closed</option>
            </select>
          </div>

          <div class="md:col-span-2">
            <label for="description" class="block text-sm font-medium mb-2">
              Description
            </label>
            <textarea id="description" rows="3" required
              placeholder="Enter customer activity, concern, or feedback..."
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
          </div>

          <div class="md:col-span-2 flex justify-end">
            <button type="submit"
              class="bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-lg font-semibold">
              Save Customer Log
            </button>
          </div>
        </form>

        <p id="formMessage" class="text-sm mt-4" role="status"></p>
      </section>

      <!-- CUSTOMER LOG TABLE -->
      <section class="bg-white rounded-xl shadow-sm p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
          <div>
            <h3 class="text-lg font-bold">Customer Activity Records</h3>
            <p class="text-sm text-slate-500">View and update recorded customer activities.</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <input id="searchLogs" type="search"
              placeholder="Search customer or description..."
              class="border border-slate-300 rounded-lg px-3 py-2">

            <select id="filterStatus"
              class="border border-slate-300 rounded-lg px-3 py-2">
              <option value="all">All Statuses</option>
              <option value="open">Open</option>
              <option value="in_progress">In Progress</option>
              <option value="resolved">Resolved</option>
              <option value="closed">Closed</option>
            </select>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th class="px-4 py-3">Customer</th>
                <th class="px-4 py-3">Log Type</th>
                <th class="px-4 py-3">Description</th>
                <th class="px-4 py-3">Date</th>
                <th class="px-4 py-3">Status</th>
              </tr>
            </thead>
            <tbody id="logsTable">
              <tr>
                <td colspan="5" class="text-center py-8 text-slate-500">
                  Loading customer logs...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p id="tableMessage" class="text-sm text-slate-500 mt-4"></p>
      </section>

    </main>
  </div>

  <script>
    let customerLogs = [];

    const logsTable = document.getElementById("logsTable");
    const customerSelect = document.getElementById("customerId");
    const formMessage = document.getElementById("formMessage");

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (char) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        }[char];
      });
    }

    function formatDate(value) {
      if (!value) return "—";

      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "—";

      return date.toLocaleString("en-PH", {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function formatStatus(status) {
      const labels = {
        open: "Open",
        in_progress: "In Progress",
        resolved: "Resolved",
        closed: "Closed"
      };

      return labels[status] || status;
    }

    function formatLogType(type) {
      const labels = {
        refill: "Refill",
        concern: "Concern",
        feedback: "Feedback"
      };

      return labels[type] || type;
    }

    function statusClass(status) {
      const classes = {
        open: "bg-amber-100 text-amber-700",
        in_progress: "bg-blue-100 text-blue-700",
        resolved: "bg-green-100 text-green-700",
        closed: "bg-slate-200 text-slate-700"
      };

      return classes[status] || "bg-slate-100 text-slate-700";
    }

    async function loadCustomers() {
      try {
        const response = await fetch("/api/customers");
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to load customers.");
        }

        const activeCustomers = (result.data || []).filter(function (customer) {
          return customer.status === "active";
        });

        customerSelect.innerHTML =
          '<option value="">Select a customer</option>';

        activeCustomers.forEach(function (customer) {
          const option = document.createElement("option");
          option.value = customer.id;
          option.textContent =
            customer.firstName + " " +
            (customer.middleName ? customer.middleName + " " : "") +
            customer.lastName;

          customerSelect.appendChild(option);
        });

        if (activeCustomers.length === 0) {
          customerSelect.innerHTML =
            '<option value="">No active customers available</option>';
        }

      } catch (error) {
        customerSelect.innerHTML =
          '<option value="">Unable to load customers</option>';
        console.error(error);
      }
    }

    function updateStatistics() {
      document.getElementById("totalLogs").textContent = customerLogs.length;

      document.getElementById("openLogs").textContent =
        customerLogs.filter(log => log.status === "open").length;

      document.getElementById("progressLogs").textContent =
        customerLogs.filter(log => log.status === "in_progress").length;

      document.getElementById("resolvedLogs").textContent =
        customerLogs.filter(log => log.status === "resolved").length;

      document.getElementById("closedLogs").textContent =
        customerLogs.filter(log => log.status === "closed").length;
    }

    function renderLogs() {
      const search = document.getElementById("searchLogs").value.toLowerCase().trim();
      const statusFilter = document.getElementById("filterStatus").value;

      const filteredLogs = customerLogs.filter(function (log) {
        const customer = log.customer || {};

        const customerName = [
          customer.firstName,
          customer.middleName,
          customer.lastName
        ].filter(Boolean).join(" ").toLowerCase();

        const description = String(log.description || "").toLowerCase();
        const type = String(log.logType || "").toLowerCase();

        const matchesSearch =
          customerName.includes(search) ||
          description.includes(search) ||
          type.includes(search);

        const matchesStatus =
          statusFilter === "all" || log.status === statusFilter;

        return matchesSearch && matchesStatus;
      });

      if (filteredLogs.length === 0) {
        logsTable.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-8 text-slate-500">
              No customer logs found.
            </td>
          </tr>
        `;
        return;
      }

      logsTable.innerHTML = filteredLogs.map(function (log) {
        const customer = log.customer || {};

        const customerName = [
          customer.firstName,
          customer.middleName,
          customer.lastName
        ].filter(Boolean).join(" ") || "Unknown Customer";

        return `
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-4 font-medium">
              ${escapeHTML(customerName)}
            </td>

            <td class="px-4 py-4">
              ${escapeHTML(formatLogType(log.logType))}
            </td>

            <td class="px-4 py-4 min-w-48">
              ${escapeHTML(log.description)}
            </td>

            <td class="px-4 py-4 whitespace-nowrap">
              ${escapeHTML(formatDate(log.loggedAt))}
            </td>

            <td class="px-4 py-4">
              <select
                class="border rounded-lg px-2 py-2 text-xs ${statusClass(log.status)}"
                data-log-id="${escapeHTML(log.id)}"
                aria-label="Update status for log ${escapeHTML(log.id)}">
                <option value="open" ${log.status === "open" ? "selected" : ""}>Open</option>
                <option value="in_progress" ${log.status === "in_progress" ? "selected" : ""}>In Progress</option>
                <option value="resolved" ${log.status === "resolved" ? "selected" : ""}>Resolved</option>
                <option value="closed" ${log.status === "closed" ? "selected" : ""}>Closed</option>
              </select>
            </td>
          </tr>
        `;
      }).join("");
    }

    async function loadCustomerLogs() {
      try {
        const response = await fetch("/api/customer-logs");
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to load customer logs.");
        }

        customerLogs = (result.data || []).sort(function (a, b) {
          return new Date(b.loggedAt) - new Date(a.loggedAt);
        });

        updateStatistics();
        renderLogs();

      } catch (error) {
        logsTable.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-8 text-red-600">
              Unable to load customer logs. Please try again.
            </td>
          </tr>
        `;

        console.error(error);
      }
    }

    document.getElementById("customerLogForm").addEventListener("submit", async function (event) {
      event.preventDefault();

      const payload = {
        customerId: document.getElementById("customerId").value,
        logType: document.getElementById("logType").value,
        description: document.getElementById("description").value.trim(),
        status: document.getElementById("logStatus").value
      };

      if (!payload.customerId || !payload.logType || !payload.description) {
        formMessage.textContent = "Please complete all required fields.";
        formMessage.className = "text-sm mt-4 text-red-600";
        return;
      }

      try {
        const response = await fetch("/api/customer-logs", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to save customer log.");
        }

        formMessage.textContent = "Customer log saved successfully.";
        formMessage.className = "text-sm mt-4 text-green-600";

        this.reset();
        document.getElementById("logStatus").value = "open";

        await loadCustomerLogs();

      } catch (error) {
        formMessage.textContent = error.message;
        formMessage.className = "text-sm mt-4 text-red-600";
      }
    });

    logsTable.addEventListener("change", async function (event) {
      const select = event.target.closest("select[data-log-id]");
      if (!select) return;

      const logId = select.dataset.logId;
      const newStatus = select.value;

      select.disabled = true;

      try {
        const response = await fetch("/api/customer-logs/" + encodeURIComponent(logId) + "/status", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ status: newStatus })
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to update status.");
        }

        const log = customerLogs.find(item => String(item.id) === String(logId));
        if (log) log.status = newStatus;

        updateStatistics();
        renderLogs();

      } catch (error) {
        alert(error.message);
        await loadCustomerLogs();
      }
    });

    document.getElementById("searchLogs").addEventListener("input", renderLogs);
    document.getElementById("filterStatus").addEventListener("change", renderLogs);

    document.addEventListener("DOMContentLoaded", function () {
      loadCustomers();
      loadCustomerLogs();
    });
  </script>
</body>
</html>
