
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Customers | AquaPiol</title>
</head>

<body class="bg-slate-100 min-h-screen">

  <div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white p-6 hidden md:block">
      <h1 class="text-2xl font-bold text-cyan-400 mb-10">AquaPiol</h1>

      <nav class="space-y-3">
        <a href="/dashboard" class="block p-3 rounded-lg hover:bg-slate-800">Dashboard</a>
        <a href="/customers" class="block p-3 rounded-lg bg-cyan-600 text-white">Customers</a>
        <a href="/customer-logs" class="block p-3 rounded-lg hover:bg-slate-800">Customer Logs</a>
        <a href="/logout" class="block p-3 rounded-lg hover:bg-slate-800">Logout</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-10">

      <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold text-slate-800">Customers</h2>
          <p class="text-slate-500 mt-1">Manage AquaPiol customer records.</p>
        </div>

        <button onclick="openForm()"
          class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-3 rounded-lg font-semibold">
          + Add Customer
        </button>
      </div>

      <!-- Statistics -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-slate-500 text-sm">Total Customers</p>
          <h3 id="totalCustomers" class="text-3xl font-bold text-slate-800 mt-2">0</h3>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-slate-500 text-sm">Active Customers</p>
          <h3 id="activeCustomers" class="text-3xl font-bold text-cyan-600 mt-2">0</h3>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-slate-500 text-sm">Inactive Customers</p>
          <h3 id="inactiveCustomers" class="text-3xl font-bold text-slate-500 mt-2">0</h3>
        </div>
      </div>

      <!-- Customer Table -->
      <section class="bg-white rounded-xl shadow-sm p-6">
        <div class="flex flex-wrap justify-between items-center gap-3 mb-5">
          <h3 class="text-xl font-bold text-slate-800">Customer Records</h3>

          <input
            id="searchCustomer"
            type="text"
            placeholder="Search customer..."
            oninput="filterCustomers()"
            class="border border-slate-300 rounded-lg px-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500"
          >
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-slate-50 text-slate-600 text-sm">
              <tr>
                <th class="p-4">Customer Name</th>
                <th class="p-4">Contact Number</th>
                <th class="p-4">Email</th>
                <th class="p-4">Address</th>
                <th class="p-4">Status</th>
                <th class="p-4">Action</th>
              </tr>
            </thead>

            <tbody id="customerTable" class="text-sm text-slate-700">
              <tr>
                <td colspan="6" class="p-6 text-center text-slate-500">
                  Customer records will appear here.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </main>
  </div>

  <!-- Add / Edit Customer Modal -->
  <div id="customerModal" class="hidden fixed inset-0 bg-black/50 items-center justify-center p-4">
    <div class="bg-white rounded-xl p-6 w-full max-w-lg">
      <h3 id="formTitle" class="text-xl font-bold text-slate-800 mb-5">Add Customer</h3>

      <form id="customerForm" class="space-y-4">
        <input type="hidden" id="customerId">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input id="firstName" required placeholder="First Name"
            class="border rounded-lg p-3 w-full">

          <input id="lastName" required placeholder="Last Name"
            class="border rounded-lg p-3 w-full">

          <input id="middleName" placeholder="Middle Name"
            class="border rounded-lg p-3 w-full">

          <input id="contactNumber" required placeholder="Contact Number"
            class="border rounded-lg p-3 w-full">

          <input id="email" type="email" placeholder="Email Address"
            class="border rounded-lg p-3 w-full sm:col-span-2">

          <textarea id="address" required placeholder="Complete Address"
            class="border rounded-lg p-3 w-full sm:col-span-2"></textarea>
        </div>

        <p id="formMessage" class="text-sm text-red-600"></p>

        <div class="flex justify-end gap-3">
          <button type="button" onclick="closeForm()"
            class="px-4 py-2 rounded-lg bg-slate-200 text-slate-700">
            Cancel
          </button>

          <button type="submit"
            class="px-5 py-2 rounded-lg bg-cyan-600 text-white">
            Save Customer
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let customers = [];

    
async function loadCustomers() {
  const table = document.getElementById("customerTable");

  try {
    const response = await fetch("/api/customers");
    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to load customers.");
    }

    customers = result.data || [];

    updateStatistics();
    renderCustomers(customers);

  } catch (error) {
    table.innerHTML = `
      <tr>
        <td colspan="6" class="p-6 text-center text-red-500">
          Unable to load customer records.
        </td>
      </tr>`;
  }
}


    function updateStatistics() {
      document.getElementById("totalCustomers").textContent = customers.length;
      document.getElementById("activeCustomers").textContent =
        customers.filter(c => c.status === "active").length;
      document.getElementById("inactiveCustomers").textContent =
        customers.filter(c => c.status === "inactive").length;
    }

    function renderCustomers(data) {
      const table = document.getElementById("customerTable");

      if (!data.length) {
        table.innerHTML = `
          <tr>
            <td colspan="6" class="p-6 text-center text-slate-500">
              No customer records found.
            </td>
          </tr>`;
        return;
      }

      table.innerHTML = data.map(c => `
        <tr class="border-b hover:bg-slate-50">
          <td class="p-4 font-semibold">${escapeHTML(c.firstName)} ${escapeHTML(c.lastName)}</td>
          <td class="p-4">${escapeHTML(c.contactNumber)}</td>
          <td class="p-4">${escapeHTML(c.email || "-")}</td>
          <td class="p-4">${escapeHTML(c.address)}</td>
          <td class="p-4">
            <span class="px-3 py-1 rounded-full text-xs ${
              c.status === "active"
                ? "bg-cyan-100 text-cyan-700"
                : "bg-slate-200 text-slate-600"
            }">${escapeHTML(c.status)}</span>
          </td>
          <td class="p-4 whitespace-nowrap">
            <button onclick="editCustomer(${Number(c.id)})"
              class="text-cyan-700 font-semibold mr-3">Edit</button>
            ${c.status === "active" ? `
              <button onclick="archiveCustomer(${Number(c.id)})"
                class="text-red-600 font-semibold">Archive</button>
            ` : ""}
          </td>
        </tr>
      `).join("");
    }

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function filterCustomers() {
      const keyword = document.getElementById("searchCustomer").value.toLowerCase();

      const filtered = customers.filter(c =>
        `${c.firstName} ${c.lastName} ${c.contactNumber} ${c.email || ""}`
          .toLowerCase().includes(keyword)
      );

      renderCustomers(filtered);
    }

    function openForm() {
      document.getElementById("customerForm").reset();
      document.getElementById("customerId").value = "";
      document.getElementById("formTitle").textContent = "Add Customer";
      document.getElementById("formMessage").textContent = "";

      const modal = document.getElementById("customerModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeForm() {
      const modal = document.getElementById("customerModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    function editCustomer(id) {
      const c = customers.find(customer => Number(customer.id) === id);
      if (!c) return;

      document.getElementById("customerId").value = c.id;
      document.getElementById("firstName").value = c.firstName || "";
      document.getElementById("lastName").value = c.lastName || "";
      document.getElementById("middleName").value = c.middleName || "";
      document.getElementById("contactNumber").value = c.contactNumber || "";
      document.getElementById("email").value = c.email || "";
      document.getElementById("address").value = c.address || "";
      document.getElementById("formTitle").textContent = "Edit Customer";
      document.getElementById("formMessage").textContent = "";

      const modal = document.getElementById("customerModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    document.getElementById("customerForm").addEventListener("submit", async event => {
      event.preventDefault();

      const id = document.getElementById("customerId").value;

      const customerData = {
        firstName: document.getElementById("firstName").value.trim(),
        lastName: document.getElementById("lastName").value.trim(),
        middleName: document.getElementById("middleName").value.trim(),
        contactNumber: document.getElementById("contactNumber").value.trim(),
        email: document.getElementById("email").value.trim() || null,
        address: document.getElementById("address").value.trim()
      };

      try {
        const response = await fetch(
          id ? `/api/customers/${id}` : "/api/customers",
          {
            method: id ? "PUT" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(customerData)
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Unable to save customer.");
        }

        closeForm();
        await loadCustomers();
        alert(id ? "Customer updated successfully." : "Customer added successfully.");

      } catch (error) {
        document.getElementById("formMessage").textContent = error.message;
      }
    });

    async function archiveCustomer(id) {
      if (!confirm("Are you sure you want to archive this customer?")) return;

      try {
        const response = await fetch(`/api/customers/${id}/archive`, {
          method: "PATCH"
        });

        if (!response.ok) throw new Error("Unable to archive customer.");

        await loadCustomers();
        alert("Customer archived successfully.");

      } catch (error) {
        alert(error.message);
      }
    }

    loadCustomers();
  </script>

</body>
</html>
