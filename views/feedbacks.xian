<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Customer Feedbacks | AquaPiol</title>
</head>

<body class="bg-slate-100 min-h-screen">
<div class="flex min-h-screen">

  <aside class="w-64 bg-slate-900 text-white p-6 hidden md:block">
    <h1 class="text-2xl font-bold text-cyan-400 mb-10">AquaPiol</h1>
    <nav class="space-y-2">
      <a href="/dashboard" class="block p-3 rounded-lg hover:bg-slate-800">Dashboard</a>
      <a href="/customers" class="block p-3 rounded-lg hover:bg-slate-800">Customers</a>
      <a href="/customer-logs" class="block p-3 rounded-lg hover:bg-slate-800">Customer Logs</a>
      <p class="text-xs text-cyan-400 font-bold pt-5 px-3">TRANSACTION MANAGEMENT</p>
      <a href="/orders" class="block p-3 rounded-lg hover:bg-slate-800">Orders</a>
      <a href="/water-activities" class="block p-3 rounded-lg hover:bg-slate-800">Water Activities</a>
      <p class="text-xs text-cyan-400 font-bold pt-5 px-3">CUSTOMER FEEDBACK</p>
      <a href="/feedbacks" class="block p-3 rounded-lg bg-cyan-600 text-white">Feedbacks</a>
      <a href="/logout" class="block p-3 rounded-lg hover:bg-slate-800 mt-5">Logout</a>
    </nav>
  </aside>

  <main class="flex-1 p-5 md:p-10">

    <header class="mb-8">
      <h2 class="text-3xl font-bold text-slate-800">Customer Feedback Management</h2>
      <p class="text-slate-500 mt-1">Collect and monitor customer ratings and feedback for AquaPiol.</p>
    </header>

    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
      <div class="bg-white p-6 rounded-xl shadow-sm">
        <p class="text-sm text-slate-500">Total Feedback</p>
        <h3 id="totalFeedback" class="text-3xl font-bold mt-2">0</h3>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm">
        <p class="text-sm text-slate-500">Average Rating</p>
        <h3 id="averageRating" class="text-3xl font-bold text-amber-500 mt-2">0.0 ★</h3>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm">
        <p class="text-sm text-slate-500">5-Star Ratings</p>
        <h3 id="fiveStarCount" class="text-3xl font-bold text-green-600 mt-2">0</h3>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm">
        <p class="text-sm text-slate-500">Low Ratings (1–2)</p>
        <h3 id="lowRatingCount" class="text-3xl font-bold text-red-600 mt-2">0</h3>
      </div>
    </section>

    <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
      <div class="mb-5">
        <h3 class="text-xl font-bold">Submit Customer Feedback</h3>
        <p class="text-sm text-slate-500 mt-1">Record a customer's rating and comments.</p>
      </div>

      <form id="feedbackForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <div>
          <label for="customerId" class="block text-sm font-medium mb-2">Select Customer *</label>
          <select id="customerId" required
            class="w-full border border-slate-300 rounded-lg px-3 py-3 outline-none focus:ring-2 focus:ring-cyan-500">
            <option value="">Loading customers...</option>
          </select>
        </div>

        <div>
          <label for="rating" class="block text-sm font-medium mb-2">Customer Rating *</label>
          <select id="rating" required
            class="w-full border border-slate-300 rounded-lg px-3 py-3 outline-none focus:ring-2 focus:ring-cyan-500">
            <option value="">Select rating</option>
            <option value="5">5 - Excellent</option>
            <option value="4">4 - Very Good</option>
            <option value="3">3 - Good</option>
            <option value="2">2 - Fair</option>
            <option value="1">1 - Poor</option>
          </select>
          <p id="ratingStars" class="text-amber-500 text-xl mt-2">☆☆☆☆☆</p>
        </div>

        <div class="md:col-span-2">
          <label for="message" class="block text-sm font-medium mb-2">Feedback Message *</label>
          <textarea id="message" rows="4" maxlength="5000" required
            placeholder="Enter the customer's feedback or comments..."
            class="w-full border border-slate-300 rounded-lg px-3 py-3 outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
          <p class="text-xs text-slate-400 mt-1">Maximum 5,000 characters.</p>
        </div>

        <div class="md:col-span-2 flex flex-wrap items-center gap-3">
          <button id="saveButton" type="submit"
            class="bg-cyan-600 hover:bg-cyan-700 disabled:opacity-50 text-white px-6 py-3 rounded-lg font-semibold">
            Submit Feedback
          </button>
          <button type="reset"
            class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-6 py-3 rounded-lg font-semibold">
            Clear Form
          </button>
          <p id="formMessage" class="text-sm" role="status"></p>
        </div>

      </form>
    </section>

    <section class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex flex-wrap justify-between items-center gap-4 mb-5">
        <div>
          <h3 class="text-xl font-bold">Customer Feedback Records</h3>
          <p class="text-sm text-slate-500 mt-1">Review customer ratings and submitted messages.</p>
        </div>

        <div class="flex flex-wrap gap-3">
          <input id="searchInput" type="search"
            placeholder="Search customer or feedback..."
            class="border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-cyan-500">

          <select id="ratingFilter"
            class="border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <option value="">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="p-3">Customer</th>
              <th class="p-3">Rating</th>
              <th class="p-3">Feedback Message</th>
              <th class="p-3">Date Submitted</th>
              <th class="p-3">Action</th>
            </tr>
          </thead>

          <tbody id="feedbackTable" class="divide-y divide-slate-100">
            <tr>
              <td colspan="5" class="p-5 text-center text-slate-500">Loading feedback...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p id="recordCount" class="text-sm text-slate-500 mt-4">0 feedback record(s).</p>
    </section>

  </main>
</div>

<!-- View Feedback Modal -->
<div id="viewModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6">
    <div class="flex justify-between items-center mb-5">
      <h3 class="text-xl font-bold text-slate-800">Feedback Details</h3>
      <button type="button" onclick="closeViewModal()"
        class="text-slate-500 hover:text-slate-800 text-2xl">&times;</button>
    </div>

    <div class="space-y-4">
      <div>
        <p class="text-xs text-slate-500">Customer</p>
        <p id="viewCustomer" class="font-semibold text-slate-800"></p>
      </div>

      <div>
        <p class="text-xs text-slate-500">Rating</p>
        <p id="viewRating" class="text-xl text-amber-500"></p>
      </div>

      <div>
        <p class="text-xs text-slate-500">Feedback Message</p>
        <p id="viewMessage" class="text-slate-700 whitespace-pre-wrap break-words"></p>
      </div>

      <div>
        <p class="text-xs text-slate-500">Date Submitted</p>
        <p id="viewDate" class="text-slate-700"></p>
      </div>
    </div>

    <div class="flex justify-end mt-6">
      <button type="button" onclick="closeViewModal()"
        class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-5 py-2 rounded-lg font-semibold">
        Close
      </button>
    </div>
  </div>
</div>

<script>
let feedbacks = [];
let activeCustomers = [];

const form = document.getElementById("feedbackForm");
const saveButton = document.getElementById("saveButton");
const formMessage = document.getElementById("formMessage");

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

function customerName(customer) {
  if (!customer) return "Unknown Customer";

  return [
    customer.firstName,
    customer.middleName,
    customer.lastName
  ].filter(Boolean).join(" ");
}

function formatDate(value) {
  if (!value) return "—";

  const date = new Date(value);

  return Number.isNaN(date.getTime())
    ? "—"
    : date.toLocaleString();
}

function renderStars(rating) {
  const value = Math.max(0, Math.min(5, Number(rating) || 0));

  return "★".repeat(value) + "☆".repeat(5 - value);
}

async function loadCustomers() {
  const select = document.getElementById("customerId");

  try {
    const response = await fetch("/api/customers");
    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to load customers.");
    }

    activeCustomers = (result.data || []).filter(
      customer => customer.status === "active"
    );

    select.innerHTML =
      '<option value="">Select a customer</option>' +
      activeCustomers.map(customer =>
        `<option value="${escapeHTML(customer.id)}">${escapeHTML(customerName(customer))}</option>`
      ).join("");

    if (!activeCustomers.length) {
      select.innerHTML = '<option value="">No active customers available</option>';
    }

  } catch (error) {
    select.innerHTML = '<option value="">Unable to load customers</option>';
    formMessage.textContent = error.message;
    formMessage.className = "text-sm text-red-600";
  }
}

function updateStatistics() {
  const total = feedbacks.length;

  const average = total
    ? feedbacks.reduce((sum, item) => sum + Number(item.rating), 0) / total
    : 0;

  const fiveStars = feedbacks.filter(
    item => Number(item.rating) === 5
  ).length;

  const lowRatings = feedbacks.filter(
    item => Number(item.rating) <= 2
  ).length;

  document.getElementById("totalFeedback").textContent = total;
  document.getElementById("averageRating").textContent = average.toFixed(1) + " ★";
  document.getElementById("fiveStarCount").textContent = fiveStars;
  document.getElementById("lowRatingCount").textContent = lowRatings;
}

function renderFeedbacks() {
  const search = document.getElementById("searchInput").value.toLowerCase().trim();
  const rating = document.getElementById("ratingFilter").value;

  const filtered = feedbacks.filter(item => {
    const name = customerName(item.customer).toLowerCase();
    const message = String(item.message || "").toLowerCase();

    const matchesSearch = name.includes(search) || message.includes(search);
    const matchesRating = !rating || Number(item.rating) === Number(rating);

    return matchesSearch && matchesRating;
  });

  const tbody = document.getElementById("feedbackTable");

  if (!filtered.length) {
    tbody.innerHTML = `
      <tr>
        <td colspan="5" class="p-5 text-center text-slate-500">
          No feedback records found.
        </td>
      </tr>`;
  } else {
    tbody.innerHTML = filtered.map(item => `
      <tr class="hover:bg-slate-50">
        <td class="p-3 font-medium">${escapeHTML(customerName(item.customer))}</td>
        <td class="p-3 whitespace-nowrap">
          <span class="text-amber-500">${escapeHTML(renderStars(item.rating))}</span>
          <span class="text-slate-500 text-xs">(${escapeHTML(item.rating)}/5)</span>
        </td>
        <td class="p-3 max-w-xs">
          <span class="block truncate">${escapeHTML(item.message)}</span>
        </td>
        <td class="p-3 whitespace-nowrap">${escapeHTML(formatDate(item.createdAt))}</td>
        <td class="p-3 whitespace-nowrap">
          <button type="button" onclick="viewFeedback(${Number(item.id)})"
            class="text-cyan-700 hover:text-cyan-900 font-semibold mr-3">
            View
          </button>
          <button type="button" onclick="deleteFeedback(${Number(item.id)})"
            class="text-red-600 hover:text-red-800 font-semibold">
            Delete
          </button>
        </td>
      </tr>
    `).join("");
  }

  document.getElementById("recordCount").textContent =
    `${filtered.length} feedback record(s).`;
}

async function loadFeedbacks() {
  const tbody = document.getElementById("feedbackTable");

  try {
    const response = await fetch("/api/feedbacks");
    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to load feedback records.");
    }

    feedbacks = (result.data || []).sort(
      (a, b) => new Date(b.createdAt) - new Date(a.createdAt)
    );

    updateStatistics();
    renderFeedbacks();

  } catch (error) {
    tbody.innerHTML = `
      <tr>
        <td colspan="5" class="p-5 text-center text-red-600">
          ${escapeHTML(error.message)}
        </td>
      </tr>`;
  }
}

form.addEventListener("submit", async event => {
  event.preventDefault();

  const customerId = document.getElementById("customerId").value;
  const rating = Number(document.getElementById("rating").value);
  const message = document.getElementById("message").value.trim();

  if (
    !customerId ||
    !Number.isInteger(rating) ||
    rating < 1 ||
    rating > 5 ||
    !message
  ) {
    formMessage.textContent = "Please complete all required fields and select a rating from 1 to 5.";
    formMessage.className = "text-sm text-red-600";
    return;
  }

  saveButton.disabled = true;
  saveButton.textContent = "Submitting...";
  formMessage.textContent = "";

  try {
    const response = await fetch("/api/feedbacks", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        customerId: Number(customerId),
        rating,
        message
      })
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to submit feedback.");
    }

    form.reset();
    document.getElementById("ratingStars").textContent = "☆☆☆☆☆";

    await loadFeedbacks();

    formMessage.textContent = "Customer feedback submitted successfully.";
    formMessage.className = "text-sm text-green-600";

  } catch (error) {
    formMessage.textContent = error.message;
    formMessage.className = "text-sm text-red-600";

  } finally {
    saveButton.disabled = false;
    saveButton.textContent = "Submit Feedback";
  }
});

document.getElementById("rating").addEventListener("change", event => {
  const rating = Number(event.target.value) || 0;

  document.getElementById("ratingStars").textContent = renderStars(rating);
});

form.addEventListener("reset", () => {
  document.getElementById("ratingStars").textContent = "☆☆☆☆☆";
  formMessage.textContent = "";
});

async function viewFeedback(id) {
  try {
    const response = await fetch(`/api/feedbacks/${id}`);
    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to retrieve feedback.");
    }

    const item = result.data;

    document.getElementById("viewCustomer").textContent =
      customerName(item.customer);

    document.getElementById("viewRating").textContent =
      renderStars(item.rating) + ` (${item.rating}/5)`;

    document.getElementById("viewMessage").textContent = item.message;
    document.getElementById("viewDate").textContent = formatDate(item.createdAt);

    document.getElementById("viewModal").classList.remove("hidden");

  } catch (error) {
    alert(error.message);
  }
}

function closeViewModal() {
  document.getElementById("viewModal").classList.add("hidden");
}

async function deleteFeedback(id) {
  const item = feedbacks.find(feedback => Number(feedback.id) === Number(id));

  if (!item) return;

  const confirmed = confirm(
    `Are you sure you want to delete this feedback from ${customerName(item.customer)}? This action cannot be undone.`
  );

  if (!confirmed) return;

  try {
    const response = await fetch(`/api/feedbacks/${id}`, {
      method: "DELETE"
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Unable to delete feedback.");
    }

    await loadFeedbacks();
    alert("Feedback deleted successfully.");

  } catch (error) {
    alert(error.message);
  }
}

document.getElementById("searchInput").addEventListener("input", renderFeedbacks);
document.getElementById("ratingFilter").addEventListener("change", renderFeedbacks);

document.getElementById("viewModal").addEventListener("click", event => {
  if (event.target.id === "viewModal") {
    closeViewModal();
  }
});

async function initializePage() {
  await loadCustomers();
  await loadFeedbacks();
}

initializePage();
</script>

</body>
</html>
