<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Orders | AquaPiol</title>
</head>

<body class="bg-slate-100 min-h-screen">
  <div class="flex min-h-screen">

    <aside class="w-64 bg-slate-900 text-white p-6 hidden md:block">
      <h1 class="text-2xl font-bold text-cyan-400 mb-10">AquaPiol</h1>
      <nav class="space-y-2">
        <a href="/dashboard" class="block p-3 rounded-lg hover:bg-slate-800">Dashboard</a>
        <a href="/customers" class="block p-3 rounded-lg hover:bg-slate-800">Customers</a>
        <a href="/customer-logs" class="block p-3 rounded-lg hover:bg-slate-800">Customer Logs</a>
        <p class="text-xs text-cyan-400 font-bold pt-5 px-3">TRANSACTION MANAGEMENT</p>
        <a href="/orders" class="block p-3 rounded-lg bg-cyan-600 text-white">Orders</a>
        <a href="/water-activities" class="block p-3 rounded-lg hover:bg-slate-800">Water Activities</a>
        <p class="text-xs text-cyan-400 font-bold pt-5 px-3">CUSTOMER FEEDBACK</p>
        <a href="/feedbacks" class="block p-3 rounded-lg hover:bg-slate-800">Feedbacks</a>
        <a href="/logout" class="block p-3 rounded-lg hover:bg-slate-800 mt-5">Logout</a>
      </nav>
    </aside>

    <main class="flex-1 p-5 md:p-10">

      <header class="flex flex-wrap justify-between items-center gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold text-slate-800">Orders Management</h2>
          <p class="text-slate-500 mt-1">Manage AquaPiol customer orders and payments.</p>
        </div>
        <button onclick="openOrderForm()"
          class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-3 rounded-lg font-semibold">
          + Add Order
        </button>
      </header>

      <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-sm text-slate-500">Total Orders</p>
          <h3 id="totalOrders" class="text-3xl font-bold mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-sm text-slate-500">Pending</p>
          <h3 id="pendingOrders" class="text-3xl font-bold text-amber-600 mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-sm text-slate-500">Completed</p>
          <h3 id="completedOrders" class="text-3xl font-bold text-green-600 mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <p class="text-sm text-slate-500">Cancelled</p>
          <h3 id="cancelledOrders" class="text-3xl font-bold text-red-600 mt-2">0</h3>
        </div>
      </section>

      <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="mb-5">
          <h3 id="formTitle" class="text-xl font-bold">Add New Order</h3>
          <p class="text-sm text-slate-500 mt-1">Enter the order details below.</p>
        </div>

        <form id="orderForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <input type="hidden" id="orderId">

          <div>
            <label for="orderNo" class="block text-sm font-medium mb-2">Order Number *</label>
            <input id="orderNo" type="text" maxlength="20" required
              placeholder="Example: ORD-0001"
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
          </div>

          <div>
            <label for="customerId" class="block text-sm font-medium mb-2">Select Customer *</label>
            <select id="customerId" required
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
              <option value="">Loading customers...</option>
            </select>
          </div>

          <div>
            <label for="totalAmount" class="block text-sm font-medium mb-2">Total Amount (₱) *</label>
            <input id="totalAmount" type="number" min="0" step="0.01" required
              placeholder="0.00"
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
          </div>

          <div>
            <label for="paymentMethod" class="block text-sm font-medium mb-2">Payment Method *</label>
            <select id="paymentMethod" required
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
              <option value="">Select payment method</option>
              <option value="Cash">Cash</option>
              <option value="GCash">GCash</option>
              <option value="Bank Transfer">Bank Transfer</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div>
            <label for="orderStatus" class="block text-sm font-medium mb-2">Order Status</label>
            <select id="orderStatus"
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
              <option value="pending">Pending</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>

          <div>
            <label for="orderedAt" class="block text-sm font-medium mb-2">Order Date *</label>
            <input id="orderedAt" type="datetime-local" required
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none">
          </div>

          <div class="md:col-span-2">
            <label for="notes" class="block text-sm font-medium mb-2">Notes</label>
            <textarea id="notes" rows="3" maxlength="500"
              placeholder="Additional order details (optional)"
              class="w-full border border-slate-300 rounded-lg px-3 py-3 focus:ring-2 focus:ring-cyan-500 outline-none"></textarea>
          </div>

          <div class="md:col-span-2 flex flex-wrap justify-end gap-3">
            <button id="cancelEditButton" type="button" onclick="resetOrderForm()"
              class="hidden bg-slate-200 hover:bg-slate-300 text-slate-700 px-5 py-3 rounded-lg font-semibold">
              Cancel Edit
            </button>
            <button id="saveOrderButton" type="submit"
              class="bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-lg font-semibold">
              Save Order
            </button>
          </div>
        </form>
        <p id="formMessage" class="text-sm mt-4" role="status"></p>
      </section>

      <section class="bg-white rounded-xl shadow-sm p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
          <div>
            <h3 class="text-xl font-bold">Order Records</h3>
            <p class="text-sm text-slate-500 mt-1">View and update customer orders.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <input id="searchOrders" type="search" placeholder="Search order or customer..."
              class="border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <select id="filterStatus"
              class="border border-slate-300 rounded-lg px-3 py-2">
              <option value="all">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th class="p-4">Order No.</th>
                <th class="p-4">Customer</th>
                <th class="p-4">Total Amount</th>
                <th class="p-4">Payment</th>
                <th class="p-4">Date</th>
                <th class="p-4">Status</th>
                <th class="p-4">Action</th>
              </tr>
            </thead>
            <tbody id="ordersTable">
              <tr><td colspan="7" class="text-center py-8 text-slate-500">Loading orders...</td></tr>
            </tbody>
          </table>
        </div>
        <p id="tableMessage" class="text-sm text-slate-500 mt-4"></p>
      </section>
    </main>
  </div>

  <script>
    let orders = [];
    let activeCustomers = [];

    const ordersTable = document.getElementById("ordersTable");
    const customerSelect = document.getElementById("customerId");
    const formMessage = document.getElementById("formMessage");

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (char) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        }[char];
      });
    }

    function customerName(customer) {
      if (!customer) return "Unknown Customer";
      return [
        customer.firstName,
        customer.middleName,
        customer.lastName
      ].filter(Boolean).join(" ") || "Unknown Customer";
    }

    function formatDate(value) {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "—";
      return date.toLocaleString("en-PH", {
        year: "numeric", month: "short", day: "numeric",
        hour: "2-digit", minute: "2-digit"
      });
    }

    function formatDateInput(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      const localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return localDate.toISOString().slice(0, 16);
    }

    function formatAmount(value) {
      return Number(value || 0).toLocaleString("en-PH", {
        style: "currency", currency: "PHP"
      });
    }

    function statusClass(status) {
      const classes = {
        pending: "bg-amber-100 text-amber-700",
        completed: "bg-green-100 text-green-700",
        cancelled: "bg-red-100 text-red-700"
      };
      return classes[status] || "bg-slate-100 text-slate-700";
    }

    async function loadCustomers() {
      try {
        const response = await fetch("/api/customers");
        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to load customers.");
        }

        activeCustomers = (result.data || []).filter(c => c.status === "active");
        customerSelect.innerHTML = '<option value="">Select a customer</option>';

        activeCustomers.forEach(customer => {
          const option = document.createElement("option");
          option.value = customer.id;
          option.textContent = customerName(customer);
          customerSelect.appendChild(option);
        });

        if (activeCustomers.length === 0) {
          customerSelect.innerHTML = '<option value="">No active customers available</option>';
        }
      } catch (error) {
        customerSelect.innerHTML = '<option value="">Unable to load customers</option>';
        formMessage.textContent = error.message;
        formMessage.className = "text-sm mt-4 text-red-600";
      }
    }

    function updateStatistics() {
      document.getElementById("totalOrders").textContent = orders.length;
      document.getElementById("pendingOrders").textContent =
        orders.filter(order => order.status === "pending").length;
      document.getElementById("completedOrders").textContent =
        orders.filter(order => order.status === "completed").length;
      document.getElementById("cancelledOrders").textContent =
        orders.filter(order => order.status === "cancelled").length;
    }

    function renderOrders() {
      const search = document.getElementById("searchOrders").value.toLowerCase().trim();
      const statusFilter = document.getElementById("filterStatus").value;

      const filteredOrders = orders.filter(order => {
        const name = customerName(order.customer).toLowerCase();
        const matchesSearch =
          String(order.orderNo || "").toLowerCase().includes(search) ||
          name.includes(search);
        const matchesStatus = statusFilter === "all" || order.status === statusFilter;
        return matchesSearch && matchesStatus;
      });

      if (filteredOrders.length === 0) {
        ordersTable.innerHTML = `
          <tr><td colspan="7" class="text-center py-8 text-slate-500">
            No orders found.
          </td></tr>`;
        return;
      }

      ordersTable.innerHTML = filteredOrders.map(order => `
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="p-4 font-semibold">${escapeHTML(order.orderNo)}</td>
          <td class="p-4">${escapeHTML(customerName(order.customer))}</td>
          <td class="p-4 whitespace-nowrap">${escapeHTML(formatAmount(order.totalAmount))}</td>
          <td class="p-4">${escapeHTML(order.paymentMethod)}</td>
          <td class="p-4 whitespace-nowrap">${escapeHTML(formatDate(order.orderedAt))}</td>
          <td class="p-4">
            <span class="px-3 py-1 rounded-full text-xs font-semibold ${statusClass(order.status)}">
              ${escapeHTML(order.status)}
            </span>
          </td>
          <td class="p-4">
            <button type="button" onclick="editOrder(${Number(order.id)})"
              class="text-cyan-700 hover:text-cyan-900 font-semibold">Edit</button>
          </td>
        </tr>
      `).join("");
    }

    async function loadOrders() {
      try {
        const response = await fetch("/api/orders");
        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to load orders.");
        }

        orders = (result.data || []).sort((a, b) =>
          new Date(b.orderedAt) - new Date(a.orderedAt)
        );
        updateStatistics();
        renderOrders();
        document.getElementById("tableMessage").textContent =
          orders.length + " order record(s).";
      } catch (error) {
        ordersTable.innerHTML = `
          <tr><td colspan="7" class="text-center py-8 text-red-600">
            Unable to load orders. Please refresh the page.
          </td></tr>`;
        console.error(error);
      }
    }

    function openOrderForm() {
      resetOrderForm();
      document.getElementById("orderNo").focus();
      document.getElementById("orderForm").scrollIntoView({
        behavior: "smooth", block: "center"
      });
    }

    function resetOrderForm() {
      document.getElementById("orderForm").reset();
      document.getElementById("orderId").value = "";
      document.getElementById("formTitle").textContent = "Add New Order";
      document.getElementById("saveOrderButton").textContent = "Save Order";
      document.getElementById("cancelEditButton").classList.add("hidden");
      document.getElementById("orderStatus").value = "pending";
      formMessage.textContent = "";
      formMessage.className = "text-sm mt-4";
    }

    function editOrder(id) {
      const order = orders.find(item => Number(item.id) === Number(id));
      if (!order) return;

      document.getElementById("orderId").value = order.id;
      document.getElementById("orderNo").value = order.orderNo || "";
      document.getElementById("customerId").value = order.customerId || "";
      document.getElementById("totalAmount").value = order.totalAmount || "";
      document.getElementById("paymentMethod").value = order.paymentMethod || "";
      document.getElementById("orderStatus").value = order.status || "pending";
      document.getElementById("orderedAt").value = formatDateInput(order.orderedAt);
      document.getElementById("notes").value = order.notes || "";

      document.getElementById("formTitle").textContent = "Edit Order";
      document.getElementById("saveOrderButton").textContent = "Update Order";
      document.getElementById("cancelEditButton").classList.remove("hidden");
      formMessage.textContent = "";

      document.getElementById("orderForm").scrollIntoView({
        behavior: "smooth", block: "center"
      });
    }

    document.getElementById("orderForm").addEventListener("submit", async function (event) {
      event.preventDefault();

      const id = document.getElementById("orderId").value;
      const payload = {
        orderNo: document.getElementById("orderNo").value.trim(),
        customerId: document.getElementById("customerId").value,
        totalAmount: document.getElementById("totalAmount").value,
        paymentMethod: document.getElementById("paymentMethod").value,
        status: document.getElementById("orderStatus").value,
        orderedAt: document.getElementById("orderedAt").value,
        notes: document.getElementById("notes").value.trim() || null
      };

      if (!payload.orderNo || !payload.customerId ||
          payload.totalAmount === "" || !payload.paymentMethod ||
          !payload.orderedAt) {
        formMessage.textContent = "Please complete all required fields.";
        formMessage.className = "text-sm mt-4 text-red-600";
        return;
      }

      if (!Number.isFinite(Number(payload.totalAmount)) || Number(payload.totalAmount) < 0) {
        formMessage.textContent = "Enter a valid non-negative total amount.";
        formMessage.className = "text-sm mt-4 text-red-600";
        return;
      }

      const saveButton = document.getElementById("saveOrderButton");
      saveButton.disabled = true;
      saveButton.textContent = id ? "Updating..." : "Saving...";

      try {
        const response = await fetch(
          id ? "/api/orders/" + encodeURIComponent(id) : "/api/orders",
          {
            method: id ? "PUT" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          }
        );

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to save order.");
        }

        resetOrderForm();
        await loadOrders();
        formMessage.textContent = id ? "Order updated successfully." : "Order created successfully.";
        formMessage.className = "text-sm mt-4 text-green-600";

      } catch (error) {
        formMessage.textContent = error.message;
        formMessage.className = "text-sm mt-4 text-red-600";
      } finally {
        saveButton.disabled = false;
        saveButton.textContent =
          document.getElementById("orderId").value ? "Update Order" : "Save Order";
      }
    });

    document.getElementById("searchOrders").addEventListener("input", renderOrders);
    document.getElementById("filterStatus").addEventListener("change", renderOrders);

    async function initializeOrdersPage() {
      await loadCustomers();
      await loadOrders();
    }

    initializeOrdersPage();
  </script>
</body>
</html>
